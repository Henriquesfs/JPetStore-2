<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Sequence">

	<resultMap id="result" type="org.springframework.samples.jpetstore.dao.mybatis.Sequence">
		<result property="name" column="name"/>
		<result property="nextId" column="nextid"/>
	</resultMap>

	<select id="getSequence" resultMap="result">
		select name, nextid from sequence where name = #{name}
	</select>

	<update id="updateSequence">
		update sequence set nextid = #{nextId} where name = #{name}
	</update>

</mapper>
